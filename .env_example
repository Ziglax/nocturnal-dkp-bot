DISCORD_TOKEN=discord_token
DISCORD_CLIENT_ID=123456789
# bare metal: mongodb://localhost:27017 — Docker (docker-compose): mongodb://mongo:27017
MONGO_URL=mongodb://localhost:27017
LOG_LEVEL=DEBUG
# Console output is also written to this file (ISO timestamps, 5 MB x 5 rotation). Empty = stdout only.
LOG_FILE=logs/bot.log
